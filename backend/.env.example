# AzureRose Environment Configuration

# AI Engine Provider
# Options: "mock" (sem chave/testes), "gemini", "openai_compatible", "local_vllm", "ollama"
AI_PROVIDER=mock

# Google Gemini (se AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI / DeepSeek (se AI_PROVIDER=openai_compatible)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Modelo Próprio Fine-Tuned / Self-Hosted (vLLM ou Ollama)
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=azurerose-llama3-8b

# Database — recomendado: PostgreSQL local com pgvector (necessário para RAG semântico)
DATABASE_URL=postgresql://azurerose:sua_senha@localhost:5432/azurerose
# Alternativa zero-config para prototipagem rápida (sem multi-usuário real nem pgvector):
# DATABASE_URL=sqlite+aiosqlite:///./azurerose.db

# Auth — chave de assinatura dos tokens JWT (gere a sua: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=troque_esta_chave
